hotkey:
  ptt: "alt_r"                # pynput key name
  replay: "cmd+shift+r"       # optional; CLI still works without this

stt:
  provider: "whisper_cpp"     # whisper_cpp (default, offline, GPU) | whisper_local (offline, CPU) | parakeet (offline, optional extra) | deepgram (cloud, needs DEEPGRAM_API_KEY)
  whisper_local:
    model: "small"            # tiny | base | small | medium | large-v3
    device: "auto"            # auto | cpu | cuda | mps
    language: "en"
  whisper_cpp:                # Whisper on the Apple GPU via Metal; ~5x faster than whisper_local
    model: "small"            # tiny | base | small | medium | large-v3-turbo | …-q5_0 quantized variants
    language: "en"
  parakeet:                   # pip install 'claude-voice[parakeet]' — Apple Silicon only (MLX)
    model: "mlx-community/parakeet-tdt-0.6b-v3"
  deepgram:
    model: "nova-2"

tts:
  enabled: true
  provider: "say"             # say (default, offline, macOS built-in) | elevenlabs (cloud, needs ELEVENLABS_API_KEY)
  mode: "summary"             # summary (default) | prose. Say "verbatim" (PTT alone) to override for the next response.
  summary_threshold: 500      # chars; above this always summarize
  min_summarize_chars: 200    # chars; below this always speak verbatim (skips Haiku even in summary mode)
  max_duration: 60            # seconds; hard cap on any TTS subprocess. Prevents wedged audio from blocking future PTT.
  elevenlabs:
    voice_id: "21m00Tcm4TlvDq8ikWAM"  # Rachel — ElevenLabs uses opaque IDs, not names
    model: "eleven_turbo_v2_5"
  say:
    voice: "Samantha"

inject:
  auto_submit: true           # press Enter after paste (submits Claude Code / any focused prompt)

feedback:
  sounds: true                # start/stop/error ticks
  menu_bar: true
  live_preview: true          # show the transcript at the bottom of the screen while you hold the key (whisper_cpp only)

logging:
  level: "info"
  path: "~/.config/claude-voice/daemon.log"
